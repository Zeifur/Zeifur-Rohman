# Apache Web Server Configuration for Zeifur Rohman Personal Web
# Clean URLs & Extensionless HTML Routing

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect requests with explicit .html extension to clean URL without .html (301 Permanent Redirect)
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Internal rewrite: serve extensionless URLs (e.g. /shop, /blog, /thank-you) using .html files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
